<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>BenedictJeromeMart</display-name>

    <!-- Session Timeout Configuration (30 Minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Default Landing Pages -->
    <welcome-file-list>
        <welcome-file>home.jsp</welcome-file>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- Admin Authentication & Security Filter Mapping -->
    <filter>
        <filter-name>AdminAuthFilter</filter-name>
        <filter-class>com.benedictjeromemart.filter.AdminAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/admin-dashboard.jsp</url-pattern>
    </filter-mapping>

    <!-- Graceful Error Handling -->
    <error-page>
        <error-code>404</error-code>
        <location>/login.jsp</location>
    </error-page>

</web-app>